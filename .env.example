# AI Code Review Agent environment configuration example

# Application
APP_NAME="AI Code Review Agent"
DEBUG=true

# LLM (Gemini) configuration
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash

# Analyzer failure policy: 'partial' (continue and return partial results) or 'strict' (fail on analyzer errors)
ANALYZER_FAILURE_MODE=partial

# Startup behaviour: if true, server startup will fail when configured analyzers/tools or required configuration files are missing
STARTUP_FAIL_ON_MISSING_ANALYZERS=false

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_PER_MINUTE=600
REDIS_CONVERSATIONS_ENABLED=false

# ChromaDB / RAG
VECTOR_DB_DIR=vector_db
RAG_COLLECTION=owasp_knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Analyzer tuning
RUFF_OPTIONS="--format=json"
BANDIT_OPTIONS="-f json"
SEMGREP_OPTIONS="--json"

# Security
SECURITY_HEADERS_ENABLED=true
CSP_ALLOW_HTTPS_FOR_DOCS=true

# Other
ORCHESTRATOR_CONCURRENCY_LIMIT=4

# NOTE: Adjust values for production. Never commit actual secrets.
